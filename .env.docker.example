# Copy to .env.docker locally; never commit the real .env.docker file.
# Generate distinct URL-safe hexadecimal values with: openssl rand -hex 24
POSTGRES_USER=holidays_admin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_DB=postgres
GATEWAY_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
ACCOMMODATION_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
BOOKING_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
PAYMENT_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_HEX_SECRET
