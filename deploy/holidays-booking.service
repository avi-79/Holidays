[Unit]
Description=Holidays Booking Service
After=network.target postgresql.service holidays-accommodation.service
[Service]
Type=simple
User=holidays
Group=holidays
WorkingDirectory=/opt/holidays
EnvironmentFile=/etc/holidays/microservices.env
Environment=PORT=8082
Environment=DATABASE_URL=%E{BOOKING_DATABASE_URL}
ExecStart=/usr/bin/node /opt/holidays/services/booking-service/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
