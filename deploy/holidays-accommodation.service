[Unit]
Description=Holidays Accommodation Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=holidays
Group=holidays
WorkingDirectory=/opt/holidays
EnvironmentFile=/etc/holidays/microservices.env
Environment=NODE_ENV=production
Environment=PORT=8081
ExecStart=/usr/bin/node /opt/holidays/services/accommodation-service/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
