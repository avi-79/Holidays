# Copy to /etc/holidays/microservices.env and replace every placeholder.
NODE_ENV=production
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
COOKIE_SECURE=false
GATEWAY_DATABASE_URL=postgresql://holidays_gateway:CHANGE_ME_GATEWAY_PASSWORD@127.0.0.1:5432/holidays_gateway
ACCOMMODATION_DATABASE_URL=postgresql://holidays_accommodation:CHANGE_ME_ACCOMMODATION_PASSWORD@127.0.0.1:5432/holidays_accommodation
BOOKING_DATABASE_URL=postgresql://holidays_booking:CHANGE_ME_BOOKING_PASSWORD@127.0.0.1:5432/holidays_booking
PAYMENT_DATABASE_URL=postgresql://holidays_payment:CHANGE_ME_PAYMENT_PASSWORD@127.0.0.1:5432/holidays_payment
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
ACCOMMODATION_URL=http://127.0.0.1:8081
BOOKING_URL=http://127.0.0.1:8082
PAYMENT_URL=http://127.0.0.1:8083
