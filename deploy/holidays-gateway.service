[Unit]
Description=Holidays API Gateway
After=network.target postgresql.service holidays-accommodation.service holidays-booking.service
[Service]
Type=simple
User=holidays
Group=holidays
WorkingDirectory=/opt/holidays
EnvironmentFile=/etc/holidays/microservices.env
Environment=PORT=8080
Environment=DATABASE_URL=%E{GATEWAY_DATABASE_URL}
ExecStart=/usr/bin/node /opt/holidays/services/api-gateway/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
